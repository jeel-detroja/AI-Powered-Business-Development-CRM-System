PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nexora_crm
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=replace_with_secure_random_secret

# Google Gemini — leave GEMINI_API_KEY empty to run without AI features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=40
